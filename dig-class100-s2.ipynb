    "import inspect\n",
    "steps_per_epoch = max(len(x_train) // Batch_Size, 1)\n",
    "base_learning_rate = 1e-3\n",
    "learning_rate_strategy = \"cosine_restarts\"  # options: 'cosine_restarts', 'exponential', 'piecewise'\n",
    "schedule_factories = {\n",
    "    \"cosine_restarts\": lambda: tf.keras.optimizers.schedules.CosineDecayRestarts(\n",
    "        initial_learning_rate=base_learning_rate,\n",
    "        first_decay_steps=max(steps_per_epoch * 5, 1),\n",
    "        t_mul=2.0,\n",
    "        m_mul=0.8,\n",
    "        alpha=1e-4,\n",
    "    ),\n",
    "    \"exponential\": lambda: tf.keras.optimizers.schedules.ExponentialDecay(\n",
    "        initial_learning_rate=base_learning_rate,\n",
    "        decay_steps=max(steps_per_epoch * 5, 1),\n",
    "        decay_rate=0.95,\n",
    "        staircase=False,\n",
    "    ),\n",
    "    \"piecewise\": lambda: tf.keras.optimizers.schedules.PiecewiseConstantDecay(\n",
    "        boundaries=[steps_per_epoch * b for b in (10, 20, 40)],\n",
    "        values=[\n",
    "            base_learning_rate,\n",
    "            base_learning_rate * 0.5,\n",
    "            base_learning_rate * 0.1,\n",
    "            base_learning_rate * 0.01,\n",
    "        ],\n",
    "    ),\n",
    "}\n",
    "\n",
    "learning_rate_schedule = schedule_factories[learning_rate_strategy]()\n",
    "\n",
    "optimizer_choice = \"adamw\"  # options: 'adamw', 'sgd', 'rmsprop'\n",
    "optimizer_registry = {\n",
    "    \"adamw\": tf.keras.optimizers.AdamW,\n",
    "    \"sgd\": tf.keras.optimizers.SGD,\n",
    "    \"rmsprop\": tf.keras.optimizers.RMSprop,\n",
    "}\n",
    "optimizer_parameters = {\n",
    "    \"adamw\": {\"weight_decay\": 1e-4, \"beta_1\": 0.9, \"beta_2\": 0.999},\n",
    "    \"sgd\": {\"momentum\": 0.9, \"nesterov\": True, \"weight_decay\": 1e-4},\n",
    "    \"rmsprop\": {\"rho\": 0.9, \"momentum\": 0.0},\n",
    "}\n",
    "\n",
    "\n",
    "def create_optimizer(name: str, learning_rate, overrides: dict | None = None):\n",
    "    name = name.lower()\n",
    "    optimizer_cls = optimizer_registry[name]\n",
    "    parameters = optimizer_parameters.get(name, {}).copy()\n",
    "    if overrides:\n",
    "        parameters.update(overrides)\n",
    "    signature = inspect.signature(optimizer_cls.__init__)\n",
    "    valid_parameters = {k: v for k, v in parameters.items() if k in signature.parameters}\n",
    "    experimental_api = getattr(tf.keras.optimizers, \"experimental\", None)\n",
    "    if (\n",
    "        \"weight_decay\" in parameters\n",
    "        and \"weight_decay\" not in valid_parameters\n",
    "        and experimental_api is not None\n",
    "    ):\n",
    "        experimental_cls = getattr(experimental_api, optimizer_cls.__name__, None)\n",
    "        if experimental_cls is not None:\n",
    "            optimizer_cls = experimental_cls\n",
    "            exp_signature = inspect.signature(optimizer_cls.__init__)\n",
    "            valid_parameters = {\n",
    "                k: v for k, v in parameters.items() if k in exp_signature.parameters\n",
    "            }\n",
    "    return optimizer_cls(learning_rate=learning_rate, **valid_parameters)\n",
    "\n",
    "\n",
    "optimizer = create_optimizer(optimizer_choice, learning_rate_schedule)\n",
    "\n",
    "model.compile(\n",
    "    loss=tf.keras.losses.CategoricalCrossentropy(from_logits=True),\n",
    "    optimizer=optimizer,\n",
    "    metrics=[\"accuracy\"],\n",
    ")\n",
    "\n",
    "model.summary()\n"
    "from keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau, LearningRateScheduler\n",
    "earlystop = EarlyStopping(\n",
    "    monitor='val_loss',\n",
    "    mode='min',\n",
    "    patience=25,\n",
    "    verbose=0,\n",
    "    restore_best_weights=True,\n",
    ")\n",
    "\n",
    "# Configure learning-rate callbacks to compare plateau reductions or custom schedulers.\n",
    "lr_callback_strategy = 'plateau'  # options: 'plateau', 'schedule', 'none'\n",
    "plateau_config = {\n",
    "    'monitor': 'val_loss',\n",
    "    'factor': 0.5,\n",
    "    'patience': 2,\n",
    "    'min_lr': 1e-6,\n",
    "    'verbose': 1,\n",
    "}\n",
    "\n",
    "def scheduled_learning_rate(epoch: int, current_lr: float) -> float:\n",
    "    step = epoch * steps_per_epoch\n",
    "    return float(learning_rate_schedule(step))\n",
    "if lr_callback_strategy == 'plateau':\n",
    "    lr_callback = ReduceLROnPlateau(**plateau_config)\n",
    "elif lr_callback_strategy == 'schedule':\n",
    "    lr_callback = LearningRateScheduler(scheduled_learning_rate, verbose=1)\n",
    "else:\n",
    "    lr_callback = None\n",
    "\n",
    "callbacks = [earlystop]\n",
    "if lr_callback is not None:\n",
    "    callbacks.append(lr_callback)\n",
    "\n",
    "history = model.fit(\n",
    "                train_iterator,\n",
    "                validation_data=validation_iterator,\n",
    "                batch_size=Batch_Size,\n",
    "                epochs=Epoch_Anz,\n",
    "                callbacks=callbacks,\n",
    "                verbose=2)\n",
    "plot_acc_loss(history, \"Trainingsresults\")\n"
